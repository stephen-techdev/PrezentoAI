# ──────────────────────────────────────────────────────────────────────────
# Prezento AI Frontend Environment Variables
# Copy this file to `.env` and adjust as needed.
# ──────────────────────────────────────────────────────────────────────────

# Backend API URL. If unreachable, the frontend falls back to its built-in
# local generator and client-side export — so the app works even without
# the backend running.
VITE_API_URL=http://localhost:8000

# Supabase (optional — only used if you wire up cloud persistence).
# The starter template includes these by default; safe to leave as-is.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
