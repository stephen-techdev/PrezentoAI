# ──────────────────────────────────────────────────────────────────────────
# prezento Backend Environment Variables
# Copy this file to `.env` and adjust as needed.
# ──────────────────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Database (SQLite file path — relative to backend/ or absolute)
DATABASE_URL=sqlite:///./data/prezento.db

# Ollama (local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Alternatives: llama3.2:3b, gemma2:2b, phi3:3.8b, mistral:7b
OLLAMA_TIMEOUT=120

# Generation defaults
DEFAULT_SLIDE_COUNT=10
MAX_SLIDE_COUNT=25
